# ============================================================
# DAPURSAJIRESTO Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-32-char-string-use-openssl-rand-base64-32
APP_NAME=DapurSajiResto
# Base domain untuk multi-tenant subdomain (misal: restoa.namadomain.com)
BASE_DOMAIN=localhost:3000
APP_PROTOCOL=http

# --- Database (PostgreSQL) ---
# Contoh Neon: postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/dapursajiresto
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dapursajiresto?schema=public"

# --- Xendit Payment Gateway ---
# Daftar di https://dashboard.xendit.co (register sebagai business)
# Sandbox/test mode: pakai key yang berawalan xnd_development_
# Production: pakai key yang berawalan xnd_production_ (butuh verifikasi KYC)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_PUBLIC_KEY=xnd_public_development_xxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set ke true kalau sudah pakai production key
XENDIT_IS_PRODUCTION=false

# --- Subscription Config ---
SUBSCRIPTION_PRICE=10000
SUBSCRIPTION_CURRENCY=IDR
SUBSCRIPTION_INTERVAL=monthly
TRIAL_DAYS=7
# Cron secret untuk proteksi endpoint /api/cron/daily
CRON_SECRET=change-this-to-random-string

# --- Email (Resend) ---
# Daftar di https://resend.com, verify domain Anda
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=DapurSajiResto <noreply@namadomain.com>
EMAIL_SUPPORT=admin@namadomain.com

# --- Info Pembayaran (untuk ditampilkan di email & dashboard) ---
PAYMENT_BANK_NAME=BCA
PAYMENT_ACCOUNT_NUMBER=5390986868
PAYMENT_ACCOUNT_NAME=HSRA HIDUP SEJAHTERA CV

# --- Socket.IO (opsional, untuk real-time server terpisah) ---
SOCKET_SERVER_URL=http://localhost:3001

# --- Penyedia Info ---
COMPANY_NAME=HSRA HIDUP SEJAHTERA CV
